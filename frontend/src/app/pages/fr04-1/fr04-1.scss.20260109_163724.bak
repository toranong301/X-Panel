.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;

  .sub {
    opacity: 0.7;
    font-size: 13px;
  }

  .header-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
}

.card {
  padding: 12px;
  margin-bottom: 12px;
}

.form-header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 12px;

  .form-title {
    display: grid;
    gap: 4px;
  }

  .form-code {
    font-weight: 700;
    font-size: 18px;
  }

  .form-name {
    font-weight: 600;
  }

  .form-sub {
    font-size: 13px;
    opacity: 0.75;
  }
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px 16px;
  min-width: 260px;

  .meta-item {
    display: grid;
    gap: 2px;
  }

  .label {
    font-size: 12px;
    opacity: 0.7;
  }

  .value {
    font-weight: 600;
  }
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
}

.w-320 { width: 320px; }

.hint {
  opacity: 0.8;
  margin: 8px 0 10px;
}

.table-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8px;
  margin: 12px 0 8px;
  font-size: 13px;

  .muted {
    opacity: 0.7;
  }
}

.empty-state {
  background: #fff8e1;
  border: 1px dashed rgba(0, 0, 0, 0.12);
  border-radius: 8px;
  padding: 10px 12px;
  margin-bottom: 8px;
  font-size: 13px;
}

.table-title {
  font-weight: 700;
  margin-top: 12px;
  margin-bottom: 6px;
}

.table-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 240px;
  gap: 16px;
  align-items: start;
}

.table-wrap {
  overflow: auto;
  padding-top: 10px;
}

.fr041-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 1400px;

  th,
  td {
    border: 1px solid rgba(0, 0, 0, 0.08);
    padding: 8px 10px;
    vertical-align: top;
  }

  thead th {
    background: #f5f5f5;
    font-weight: 600;
    text-align: center;
  }

  tbody tr.section td {
    background: #e3f2fd;
    font-weight: 700;
  }

  tbody tr.group td {
    background: #f1f8e9;
    font-weight: 600;
  }

  tbody tr.empty td {
    color: rgba(0, 0, 0, 0.55);
    font-style: italic;
  }
}

.gwp-table {
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 8px;
  padding: 10px;
  background: #fafafa;

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 6px;
  }

  th,
  td {
    padding: 6px 8px;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  th {
    background: #f1f1f1;
    font-size: 12px;
    text-align: left;
  }

  .gwp-title {
    font-weight: 700;
  }

  .gwp-note {
    margin-top: 8px;
    font-size: 11px;
    opacity: 0.7;
  }
}

.num {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.error {
  color: #b00020;
  font-weight: 600;
}

.title {
  font-weight: 700;
  margin-bottom: 4px;
}

.report {
  padding-top: 10px;
  display: grid;
  gap: 6px;

  .r {
    display: grid;
    grid-template-columns: 180px 110px 60px 1fr;
    gap: 8px;
    align-items: center;
    padding: 6px 8px;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 10px;
  }

  .ok {
    font-weight: 700;
  }
  .ok.bad {
    color: #b00020;
  }
  .lvl {
    opacity: 0.75;
    font-size: 12px;
  }
  .msg {
    opacity: 0.75;
    font-size: 12px;
  }
}

button mat-progress-spinner {
  margin-right: 6px;
}

.card--compact {
  border-left: 4px solid #0d47a1;
  background: #f6f8ff;
}

.card--standard {
  border-left: 4px solid #1b5e20;
  background: #f7fbf5;
}

.section-title {
  margin-top: 16px;
  font-weight: 700;
}

.loading-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 8px 0;
}

.items-table {
  display: grid;
  gap: 4px;
  margin-top: 8px;
}

.items-header,
.items-row {
  display: grid;
  grid-template-columns: 100px minmax(200px, 2fr) 90px 120px minmax(160px, 1.2fr) minmax(160px, 1.2fr);
  align-items: center;
  gap: 8px;
  padding: 8px 6px;
  border-radius: 6px;
}

.items-header {
  background: #eef2f6;
  font-weight: 600;
  font-size: 13px;
}

.items-row {
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.08);
}

.payload-table {
  margin-top: 8px;
  overflow-x: auto;
}

.payload-header,
.payload-row {
  display: grid;
  grid-template-columns: minmax(180px, 2fr) 80px 90px repeat(12, minmax(70px, 1fr));
  gap: 6px;
  align-items: center;
  padding: 6px 8px;
}

.payload-header {
  background: #f5f5f5;
  font-weight: 600;
  font-size: 12px;
}

.payload-row {
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  font-size: 12px;
}

.payload-key {
  font-weight: 600;
}

.payload-value {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.selected-table {
  margin-top: 8px;
  overflow-x: auto;

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1200px;
  }

  th,
  td {
    border: 1px solid rgba(0, 0, 0, 0.08);
    padding: 6px 8px;
    font-size: 12px;
    vertical-align: top;
  }

  thead th {
    background: #f5f5f5;
    font-weight: 600;
    text-align: center;
  }

  tbody tr.empty td {
    color: rgba(0, 0, 0, 0.6);
    font-style: italic;
    text-align: center;
  }
}

.ef-select {
  width: 220px;
}

.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  padding: 8px 6px;
  color: rgba(0, 0, 0, 0.6);
  font-size: 13px;
}
